RewriteEngine On

# 1) /index.html vira apenas /
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# 2) /exames.html, /especialidades.html, /sobre.html viram /exames, /especialidades, /sobre
RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 3) Remove a barra no final (/exames/ vira /exames), para não quebrar CSS, JS e imagens
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# 4) Serve /exames a partir do arquivo exames.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]